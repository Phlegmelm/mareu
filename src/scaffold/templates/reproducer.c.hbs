static uint8_t *read_all(FILE *f, size_t *out_len) {
    size_t cap = 4096, len = 0;
    uint8_t *buf = malloc(cap);
    if (!buf) return NULL;
    for (;;) {
        if (len == cap) { cap *= 2; buf = realloc(buf, cap); if (!buf) return NULL; }
        size_t n = fread(buf + len, 1, cap - len, f);
        len += n;
        if (n == 0) break;
    }
    *out_len = len;
    return buf;
}

int main(int argc, char **argv) {
    size_t len = 0;
    uint8_t *data = NULL;
    if (argc > 1) {
        FILE *f = fopen(argv[1], "rb");
        if (!f) { perror("fopen"); return 1; }
        data = read_all(f, &len);
        fclose(f);
    } else {
        data = read_all(stdin, &len);
    }
    if (!data) { fprintf(stderr, "read failed\n"); return 1; }

    fprintf(stderr, "[repro] feeding %zu bytes to target_entry\n", len);
    int rc = target_entry(data, len);
