static void cyclic(char *out, size_t n) {
    const char *set = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    size_t s = strlen(set), i = 0;
    for (size_t a = 0; a < s && i < n; a++)
      for (size_t b = 0; b < s && i < n; b++)
        for (size_t c = 0; c < s && i < n; c++)
          for (size_t d = 0; d < s && i < n; d++) {
              if (i + 4 > n) return;
              out[i++] = set[a]; out[i++] = set[b];
              out[i++] = set[c]; out[i++] = set[d];
          }
}

